# 复制为 .env 后填入密钥。不要把填好的 .env 发给别人或提交到公开仓库。
# OpenAI 兼容接口。DeepSeek 示例：deepseek-flash 最省（启研对它默认关掉思考模式）；要更强可换 deepseek-v4-pro。旧名 deepseek-chat 已列入停用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选：推理强度 low / high / max。只有支持的模型才填，不填就用模型默认值。
# LLM_REASONING_EFFORT=low

# 可选：管理员口令。设了之后，页面「连接模型」要带这个口令才能改服务器的密钥和地址；不设则只有服务器本机能改。
# ADMIN_TOKEN=

# 若使用其他兼容服务，改 BASE_URL / MODEL 即可，例如：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- 账号与数据（见 docs/DEPLOY.md「账号与数据」） ----------
# 库文件放在会保留的盘上。云函数的 /tmp 会随实例回收清空，账号和记录会一起丢。
# QIYAN_DB=/data/qiyan.db

# 手机验证码：阿里云号码认证服务「短信认证」（个人实名就能开，签名和模板用控制台赠送的）。不配就只能访客进入。
# 函数计算上给函数挂一个有号码认证权限的角色，下面两个密钥平台会自动注入（还有 ALIBABA_CLOUD_SECURITY_TOKEN）。
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# 全站每天最多发多少条验证码（默认 200；短信按条收费，这是费用上限）
# AUTH_SMS_DAILY=200
# 在反向代理后面时设 1，按 X-Forwarded-For 限频
# TRUST_PROXY=1
# 只在本机开发用：没配阿里云时验证码自己出、只打印到服务器日志。配了阿里云就不生效。线上不要设。
# AUTH_DEV_CODES=1
